Proceso determinar_mayor_valor
	Definir n, max Como Entero;
	Escribir 'Ingrese el 1º numero:';
	Leer n;
	max<-n;
	Escribir 'Ingrese el 2º numero:';
	Leer n;
	Si n > max Entonces
		max<-n;
	FinSi
	Escribir 'Ingrese el 3º numero:';
	Leer n;
	Si n > max Entonces
		max<-n;
	FinSi
	Escribir 'Ingrese el 4º numero:';
	Leer n;
	Si n > max Entonces
		max<-n;
	FinSi
	Escribir 'Ingrese el 5º numero:';
	Leer n;
	Si n > max Entonces
		max<-n;
	FinSi
	Escribir 'El mayor numero es: ', max;
FinProceso
